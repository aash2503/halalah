<?xml version="1.0" encoding="utf-8"?>
<!-- 4 x 2: left, place and source, the sun's path (drawn by Widgets.java), the next prayer and its time; right, six times as rows. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:padding="14dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="9" android:orientation="vertical">
            <TextView android:id="@+id/place" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/outfit"
                android:textColor="#F6F3E9" android:textSize="16sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" />
            <TextView android:id="@+id/src" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/outfit"
                android:textColor="#DDE2CC" android:textSize="12sp" android:singleLine="true" android:ellipsize="end" />
            <ImageView android:id="@+id/arc" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="2dp" android:layout_marginBottom="2dp"
                android:scaleType="fitCenter" android:importantForAccessibility="no" />
            <TextView android:id="@+id/nl" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/outfit"
                android:textColor="#DDE2CC" android:textSize="13sp" android:singleLine="true" android:ellipsize="end" />
            <TextView android:id="@+id/ntime" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/outfit_bold" android:includeFontPadding="false"
                android:textColor="#F6F3E9" android:textSize="36sp" android:singleLine="true" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="11" android:layout_marginStart="12dp" android:orientation="vertical">
            <LinearLayout android:id="@+id/c0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp">
                <TextView android:id="@+id/l0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/outfit" android:textColor="#F6F3E9" android:textSize="14sp" android:singleLine="true" />
                <TextView android:id="@+id/t0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/outfit" android:textColor="#F6F3E9" android:textSize="14sp" android:textStyle="bold" android:singleLine="true" />
            </LinearLayout>
            <LinearLayout android:id="@+id/c1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp">
                <TextView android:id="@+id/l1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/outfit" android:textColor="#F6F3E9" android:textSize="14sp" android:singleLine="true" />
                <TextView android:id="@+id/t1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/outfit" android:textColor="#F6F3E9" android:textSize="14sp" android:textStyle="bold" android:singleLine="true" />
            </LinearLayout>
            <LinearLayout android:id="@+id/c2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp">
                <TextView android:id="@+id/l2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/outfit" android:textColor="#F6F3E9" android:textSize="14sp" android:singleLine="true" />
                <TextView android:id="@+id/t2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/outfit" android:textColor="#F6F3E9" android:textSize="14sp" android:textStyle="bold" android:singleLine="true" />
            </LinearLayout>
            <LinearLayout android:id="@+id/c3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp">
                <TextView android:id="@+id/l3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/outfit" android:textColor="#F6F3E9" android:textSize="14sp" android:singleLine="true" />
                <TextView android:id="@+id/t3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/outfit" android:textColor="#F6F3E9" android:textSize="14sp" android:textStyle="bold" android:singleLine="true" />
            </LinearLayout>
            <LinearLayout android:id="@+id/c4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp">
                <TextView android:id="@+id/l4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/outfit" android:textColor="#F6F3E9" android:textSize="14sp" android:singleLine="true" />
                <TextView android:id="@+id/t4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/outfit" android:textColor="#F6F3E9" android:textSize="14sp" android:textStyle="bold" android:singleLine="true" />
            </LinearLayout>
            <LinearLayout android:id="@+id/c5" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp">
                <TextView android:id="@+id/l5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/outfit" android:textColor="#F6F3E9" android:textSize="14sp" android:singleLine="true" />
                <TextView android:id="@+id/t5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/outfit" android:textColor="#F6F3E9" android:textSize="14sp" android:textStyle="bold" android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
